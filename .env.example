# ---------------------------------------------------------------------------
# The ONE place to configure keys and models for this project.
# Copy this file to  .env  and fill in your key. Nothing else needs editing.
# ---------------------------------------------------------------------------

# Required: your Groq API key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Optional: override the models
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_CHAT_MODEL=openai/gpt-oss-20b
